# =============================================================================
# Voxia — modèle de configuration
# =============================================================================
# Copier ce fichier en .env puis renseigner les valeurs (php artisan key:generate
# remplit APP_KEY). Ne jamais committer le .env réel : il contient des secrets.
#
# Les valeurs VOXIA_* ci-dessous reprennent les défauts de config/voxia.php ;
# les modifier ici change les règles métier sans toucher au code.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

APP_NAME=Voxia
APP_ENV=local                 # local | staging | production
APP_KEY=                      # généré par : php artisan key:generate
APP_DEBUG=true                # false obligatoire en production
APP_URL=http://localhost:8000

# Langues de l'interface au lancement : en, fr
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Mode maintenance : file (par défaut) ou database
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12


# -----------------------------------------------------------------------------
# Journaux
# -----------------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug               # debug en local, warning ou error en production


# -----------------------------------------------------------------------------
# Base de données — PostgreSQL
# -----------------------------------------------------------------------------

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=voxia
DB_USERNAME=voxia
DB_PASSWORD=


# -----------------------------------------------------------------------------
# Redis — file d'attente, cache et sessions
# -----------------------------------------------------------------------------

REDIS_CLIENT=predis           # predis (pur PHP) ou phpredis (extension)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis        # une tâche par vidéo, supervisée par Horizon
CACHE_STORE=redis
SESSION_DRIVER=redis

SESSION_LIFETIME=120          # minutes
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Préfixe des clés Redis ; utile si plusieurs applications partagent le même Redis
# CACHE_PREFIX=


# -----------------------------------------------------------------------------
# Horizon — tableau de bord des files (exécuter « php artisan horizon » sous Linux)
# -----------------------------------------------------------------------------
# Accès au tableau de bord : défini dans app/Providers/HorizonServiceProvider.php


# -----------------------------------------------------------------------------
# Stockage des fichiers
# -----------------------------------------------------------------------------
# local en développement ; s3 en production (stockage objet compatible S3 :
# MP3, fichiers importés et exports).

FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=                 # requis pour un fournisseur autre qu'AWS
AWS_USE_PATH_STYLE_ENDPOINT=false


# -----------------------------------------------------------------------------
# Emails transactionnels (vérification de compte, fin de traitement, rappel)
# -----------------------------------------------------------------------------
# log en développement : les emails s'écrivent dans storage/logs.
# Fournisseur d'envoi à décider (SMTP, Postmark, Resend, SES…).

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# -----------------------------------------------------------------------------
# Transcription — ElevenLabs Scribe v2 (environ 0,22 $ par heure d'audio)
# -----------------------------------------------------------------------------

ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_STT_MODEL=scribe_v2


# -----------------------------------------------------------------------------
# Analyse de script publicitaire — V2 (fournisseur encore à choisir)
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5


# -----------------------------------------------------------------------------
# Outils de téléchargement et d'audio
# -----------------------------------------------------------------------------
# Chemins absolus si les binaires ne sont pas dans le PATH.
# Exemple Windows : YTDLP_BINARY="C:/tools/yt-dlp.exe"

YTDLP_BINARY=yt-dlp
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Proxy transmis à yt-dlp (proxys résidentiels). Vide = connexion directe.
# Exemple : http://user:password@proxy.example.com:8080
VOXIA_PROXY_URL=

# Délais, tentatives et dossiers de téléchargement (secondes sauf mention).
VOXIA_DOWNLOAD_TIMEOUT_SECONDS=900
VOXIA_METADATA_TIMEOUT_SECONDS=60
VOXIA_DOWNLOAD_ATTEMPTS=3
# VOXIA_TEMP_DIRECTORY=
VOXIA_YTDLP_UPDATE_AT=04:00
VOXIA_YTDLP_UPDATE_TIMEOUT_SECONDS=300


# -----------------------------------------------------------------------------
# Règles métier — plans
# -----------------------------------------------------------------------------

# Gratuit : 5 vidéos par mois, 600 s maximum par vidéo, exports TXT et SRT
VOXIA_FREE_VIDEOS_PER_MONTH=5
VOXIA_FREE_MAX_VIDEO_SECONDS=600
VOXIA_FREE_HISTORY_DAYS=30
VOXIA_FREE_HISTORY_REMINDER_DAYS_BEFORE=3

# Pro : 12 $/mois ou 96 $/an, 30 h par mois, 3 h maximum par vidéo, tous les exports
# Crédits IA : 30 par mois (provisoire)
VOXIA_PRO_PRICE_MONTHLY_USD=12
VOXIA_PRO_PRICE_YEARLY_USD=96
VOXIA_PRO_HOURS_PER_MONTH=30
VOXIA_PRO_MAX_VIDEO_SECONDS=10800
VOXIA_PRO_AI_CREDITS_PER_MONTH=30

# Pack : 5 $, 10 h valables 6 mois, 3 h maximum par vidéo, pas de crédits IA
VOXIA_PACK_PRICE_USD=5
VOXIA_PACK_HOURS=10
VOXIA_PACK_VALIDITY_MONTHS=6
VOXIA_PACK_MAX_VIDEO_SECONDS=10800

# Business : 29 $/mois ou 276 $/an, 150 h. Défini mais non vendable dans le MVP.
# La durée maximale (5 h) vient de l'offre ; le cahier ne la fixe pas.
VOXIA_BUSINESS_PRICE_MONTHLY_USD=29
VOXIA_BUSINESS_PRICE_YEARLY_USD=276
VOXIA_BUSINESS_HOURS_PER_MONTH=150
VOXIA_BUSINESS_MAX_VIDEO_SECONDS=18000
VOXIA_BUSINESS_AI_CREDITS_PER_MONTH=0


# -----------------------------------------------------------------------------
# Règles métier — fichiers, audio, sous-titres, analyse
# -----------------------------------------------------------------------------

# Fichiers importés : mp3, m4a, wav, mp4, mov, webm (liste figée dans config/voxia.php)
VOXIA_UPLOAD_MAX_SIZE_MB=2048

# Conservation des MP3 et des fichiers importés, en jours
VOXIA_MEDIA_RETENTION_DAYS=30

# Qualité du MP3, en kbit/s
VOXIA_MP3_BITRATE_KBPS=192

# Sous-titres SRT et VTT
VOXIA_SUBTITLE_MAX_CHARS_PER_LINE=42
VOXIA_SUBTITLE_MAX_LINES=2
VOXIA_SUBTITLE_MIN_DURATION_SECONDS=1
VOXIA_SUBTITLE_MAX_DURATION_SECONDS=7

# Analyse de script : 180 s maximum, 1 crédit par analyse
VOXIA_SCRIPT_ANALYSIS_MAX_SECONDS=180
VOXIA_SCRIPT_ANALYSIS_CREDITS=1

# Email de fin de traitement au-delà de cette durée de vidéo (900 s = 15 min)
VOXIA_LONG_VIDEO_EMAIL_AFTER_SECONDS=900


# -----------------------------------------------------------------------------
# Coûts et surveillance
# -----------------------------------------------------------------------------

# Coût de transcription, en dollars par heure d'audio
VOXIA_TRANSCRIPTION_COST_USD_PER_HOUR=0.22

# Alerte si la part des téléchargements en échec dépasse ce seuil (0.05 = 5 %)
VOXIA_DOWNLOAD_FAILURE_ALERT_THRESHOLD=0.05


# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"
